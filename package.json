{
  "name": "quorum-root",
  "private": true,
  "scripts": {
    "test": "pnpm -C engine test",
    "playground:run": "pnpm -C engine exec tsx ../playground/run.ts",
    "tui": "cd tui && go run ./cmd/quorum --repo \"${INIT_CWD:-$PWD}\"",
    "tui:mock": "cd tui && go run ./cmd/quorum --mock --repo \"${INIT_CWD:-$PWD}\"",
    "test:go": "cd tui && go test ./...",
    "test:all": "pnpm test && cd tui && go test ./...",
    "history:sync": "pnpm -C engine exec tsx ../scripts/history-sync.ts",
    "grade": "pnpm -C engine exec tsx ../scripts/grade-room.ts",
    "improve": "pnpm -C engine exec tsx ../scripts/improve.ts"
  },
  "type": "module"
}
